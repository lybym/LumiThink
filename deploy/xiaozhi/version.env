# E2E-04 (issue #54) — 小智私有服务端版本钉死（单一事实源）
#
# 部署脚本、CI 冒烟与回归测试都从这里读取；`deploy/xiaozhi/` 内不得出现
# 第二份版本值。修改任何一项 = 更换基线 = 必须重跑
# docs/VOICE_GATEWAY_PROTOCOL.md §3 兼容矩阵评审，并同步
# lib/domain/voice/adapter/protocol.ts 的 XIAOZHI_GATEWAY_BASELINE
# （tests/deploy/xiaozhi-deployment.spec.ts 强制两者一致）。
# shellcheck shell=bash

# --- 自建服务端（xinnan-tech/xiaozhi-esp32-server）---------------------------
# 钉死到评估 commit（非浮动 tag、非 main）。
XIAOZHI_SERVER_REPO=xinnan-tech/xiaozhi-esp32-server
XIAOZHI_SERVER_COMMIT=27399a2fb64b5910196f438a256ce0a9f868481f
# 评估时该 commit 对应的最新 tag（仅记录溯源，不作为 checkout 依据）。
XIAOZHI_SERVER_EVAL_TAG=v0.9.7

# --- 端侧固件协议基线（78/xiaozhi-esp32）-------------------------------------
# 固件协议合同评估基线；本 issue 只记录测试固件差异，不改写固件。
XIAOZHI_FIRMWARE_REPO=78/xiaozhi-esp32
XIAOZHI_FIRMWARE_BASELINE_TAG=v2.5.2
XIAOZHI_FIRMWARE_BASELINE_COMMIT=49b4380b3faa0ceadd28a3e78aaf0f311c46c57e

# --- 现有测试固件（AI-VOX3 机芯盒）-------------------------------------------
XIAOZHI_FIRMWARE_TEST_ID=v2.5.2_nulllab-ai-vox-v3
XIAOZHI_FIRMWARE_TEST_BOARD=nulllab-ai-vox-v3

# --- 服务端运行时 -------------------------------------------------------------
# requirements-gateway-minimal.txt 的版本 pin 以该 commit 的 requirements.txt 为准。
XIAOZHI_SERVER_PYTHON=3.10
