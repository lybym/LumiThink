# LumiThink R1-08 systemd unit — single-host restricted-process deployment
# (issue #20 交付范围 1: 受限进程部署方案; AC 1 干净 Linux 机器以合成数据启动).
#
# Install (see deploy/runbook.md):
#   sudo cp deploy/lumithink.service /etc/systemd/system/lumithink.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now lumithink
#
# Security model: dedicated system user, no shell, strict filesystem, no new
# privileges, minimal syscall/address-family surface, no capabilities. The
# Next.js server binds 127.0.0.1:3000 ONLY — public exposure happens solely
# through the TLS reverse proxy (deploy/caddy/Caddyfile).

[Unit]
Description=LumiThink web MVP (modular monolith, R1-08)
Documentation=https://github.com/lybym/LumiThink/blob/main/deploy/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lumithink
Group=lumithink
WorkingDirectory=/opt/lumithink
# Secrets + tuning from the controlled env file (root:root 0600; see
# deploy/env/production.example).
EnvironmentFile=/etc/lumithink/lumithink.env
ExecStart=/opt/lumithink/node_modules/.bin/next start -H 127.0.0.1 -p ${PORT}
# SIGTERM triggers the runtime's final encrypted-snapshot flush (R1-08), then
# the process exits; systemd's default stop path stays bounded.
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# --- Filesystem restriction ---------------------------------------------------
ProtectSystem=strict
# State: the encrypted snapshot + build output only.
ReadWritePaths=/var/lib/lumithink
ProtectHome=read-paths
ReadOnlyPaths=/opt/lumithink
NoExecPaths=/var/lib/lumithink
ExecPaths=/usr /bin /opt/lumithink/node_modules
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid

# --- Capability / privilege restriction ---------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=no
PrivateUsers=no
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
UMask=0027

# --- Network restriction ------------------------------------------------------
# INET/INET6 for the loopback listener + the (future, review-gated) outbound
# model API; UNIX for internal sockets. Public exposure stays with the TLS
# reverse proxy only. Outbound egress is additionally narrowed by the host
# firewall (deploy/runbook.md §egress).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# --- Syscall filter -----------------------------------------------------------
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @module
SystemCallArchitectures=native

# --- Resource bounds (single-family MVP scale) --------------------------------
LimitNOFILE=4096
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
