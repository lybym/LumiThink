# LumiThink A2A validation-environment configuration template (issue #81).
#
# Deployment model: same restricted-process shape as production
# (deploy/lumithink.service) under an ISOLATED identity/paths/ports:
#   user lumithink-validation, /etc/lumithink-validation/lumithink.env
#   (root:root 0600), release at /opt/lumithink-validation, state at
#   /var/lib/lumithink-validation, archives at /var/backups/lumithink-validation.
# NEVER commit real values; this template documents shapes AND the agreed
# RESOURCE-BUDGET INITIAL VALUES (issue #81 AC: no limit may default to
# unlimited; every value below is an initial protective setting to be
# re-measured by P1-09/#91 — adjustments must be recorded).

# --- Node runtime -------------------------------------------------------------
NODE_ENV=production
# Validation app listens on LOOPBACK ONLY, port 3311 (production uses 3000).
PORT=3311
NEXT_TELEMETRY_DISABLED=1

# --- A2A validation service port (RESERVED) ------------------------------------
# The A2A service itself does NOT exist yet (P1-01/#83). This value reserves
# the loopback port for that future listener so no other validation component
# may bind it. It is NOT a running service in this issue's scope.
LUMITHINK_A2A_VALIDATION_PORT=3312

# --- Access codes (validation uses the PUBLISHED DEMO codes only) --------------
# The validation environment runs on synthetic data with the disclosed demo
# access codes (guardian-service demo constants). Do NOT put real credentials
# here. If a hardened validation pass is needed, generate a pair the same way
# production does and never commit it:
# LUMITHINK_GUARDIAN_ACCESS_CODE=<generate: openssl rand -base64 18>
# LUMITHINK_ADMIN_ACCESS_CODE=<generate: openssl rand -base64 18>

# --- Encrypted runtime snapshot (isolated paths) --------------------------------
# AES-256-GCM key, EXACTLY 64 hex chars; prefer the controlled key FILE:
#   openssl rand -hex 32 > /etc/lumithink-validation/snapshot.key  (0600)
# LUMITHINK_SNAPSHOT_KEY_FILE=/etc/lumithink-validation/snapshot.key
# LUMITHINK_SNAPSHOT_PATH=/var/lib/lumithink-validation/snapshot.bin
# Confirmed mutations snapshot immediately; periodic cadence 60 s:
LUMITHINK_SNAPSHOT_INTERVAL_MS=60000
# Never set a persistent restore-replay flag: the one-shot post-restore replay
# is requested by deploy/restore.sh via the SELF-CLEARING marker file
# (<snapshot-dir>/restore-replay.pending). Leave this at 0/absent.
LUMITHINK_SNAPSHOT_RESTORE_REPLAY=0

# --- Resource budget initial values (issue #81 AC 3; design §13.4) -------------
# IMPORTANT: these names are the AGREED RECORD of initial budget values for
# the validation environment. The current app does not read them yet — the
# runtime enforcement wiring lands with P1 tasks (#83–#91). They are
# authoritative as RECORDED LIMITS (no limit defaults to unlimited), not as
# already-implemented env switches.
# Queue / concurrency limits (frozen design initial protective configuration):
LUMITHINK_MAX_ACTIVE_WORKERS=2
LUMITHINK_MAX_MODEL_REQUESTS=2
LUMITHINK_MAX_QUEUE_PER_HOUSEHOLD=4
LUMITHINK_MAX_QUEUE_GLOBAL=8
LUMITHINK_EXECUTION_TIMEOUT_MS=120000
LUMITHINK_WAIT_INPUT_TIMEOUT_MS=600000
LUMITHINK_MAX_MODEL_CALLS_PER_TASK=8
LUMITHINK_MAX_TOKENS_PER_TASK=32000
# Daily per-household token budget: explicit INITIAL value (200k). Production
# MUST fill an explicit value before formal operation; absence blocks formal
# run per A2A_DESIGN §13.4. Re-measured by P1-09 (#91).
LUMITHINK_DAILY_TOKEN_BUDGET_PER_HOUSEHOLD=200000
# Disk pressure thresholds (deployment-side initial values):
LUMITHINK_DISK_ALERT_USAGE_PERCENT=80
LUMITHINK_DISK_ALERT_FREE_MB=2048
# SQLite bounded write behavior (design §13.4): lock wait + retry budget 5 s.
LUMITHINK_SQLITE_LOCK_BUDGET_MS=5000
# Idle worker reclaim: repository default 120 s (deployment currently disables
# it — deviation D2; unified decision is #82's. Do NOT default to unlimited.)
LUMITHINK_WORKER_IDLE_RECLAIM_MS=120000

# --- Explicitly NOT here --------------------------------------------------------
# Model provider keys: the app never reads provider credentials at startup.
# The validation default is the in-process Mock (zero egress). Real-provider
# activation requires the independent data-egress review; its key is
# request-time injected per MODEL_GATEWAY.md, never here.
# systemd-level limits (MemoryMax=1G, TasksMax=128, LimitNOFILE=4096) live in
# the unit file, not in env — copy deploy/lumithink.service per README §4.
