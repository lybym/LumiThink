# LumiThink R1-00 root baseline — configuration example.
#
# First boot of this baseline requires NO real model provider key, NO real
# child data and NO database connection (see lib/env.ts and /api/health).
# Copy this file to .env (git-ignored) only when you need the frozen legacy
# Prisma layer locally. Never put real child data or real credentials in
# committed files, issues, CI logs or ordinary logs.

# Node environment: development | production | test (default: development)
NODE_ENV=development

# Optional. Only consumed by the frozen legacy Prisma layer (lib/db.ts and the
# deprecated server actions in app/actions/). Must use the SQLite file: scheme
# while prisma/schema.prisma is frozen to SQLite. Leave unset for a clean boot.
# DATABASE_URL="file:./data/lumithink-dev.db"

# Next.js telemetry is kept off by default in CI; keep it off locally too.
NEXT_TELEMETRY_DISABLED=1

# Model provider keys: the baseline app does not read any provider credential
# at startup and performs no model egress. Do not add provider keys here.

# ---------------------------------------------------------------------------
# E2E-03 (issue #53) OPTIONAL real-provider activation — the DSH runtime's
# model route through the loopback Model Gateway egress proxy. EVERYTHING
# below is unset on the synthetic/Mock boot (CI + default dev). The real
# route is opt-in for reviewed test environments ONLY; see
# docs/MODEL_GATEWAY.md §7 and lib/server/real-provider-composition.ts.
# ---------------------------------------------------------------------------

# Route selector: mock (default) | real. Any other value fails closed.
# LUMITHINK_MODEL_ROUTE=real
# The reviewed provider endpoint origin (https in production; loopback http
# only for synthetic servers) and the single model id bound to it.
# LUMITHINK_REAL_PROVIDER_BASEURL=
# LUMITHINK_REAL_PROVIDER_MODEL_ID=deepseek-v4-flash
# The data-egress review record the runtime must be able to name (reviewer +
# reason; issue #53 实施范围 3). Without it the real route refuses to start.
# LUMITHINK_REAL_PROVIDER_REVIEWER=
# LUMITHINK_REAL_PROVIDER_REVIEW_REASON=
# Output ceiling, integer pricing (micro-USD per million tokens), explicit
# daily budget, per-attempt timeout and retry/breaker bounds.
# LUMITHINK_REAL_PROVIDER_MAX_OUTPUT_TOKENS=2048
# LUMITHINK_REAL_PROVIDER_INPUT_MICRO_USD_PER_MTOKEN=
# LUMITHINK_REAL_PROVIDER_OUTPUT_MICRO_USD_PER_MTOKEN=
# LUMITHINK_REAL_PROVIDER_MAX_REQUESTS_PER_DAY=
# LUMITHINK_REAL_PROVIDER_MAX_COST_MICRO_USD_PER_DAY=
# LUMITHINK_REAL_PROVIDER_MAX_TOTAL_TOKENS_PER_DAY=
# LUMITHINK_REAL_PROVIDER_REQUEST_TIMEOUT_MS=60000
# LUMITHINK_REAL_PROVIDER_RETRY_MAX_ATTEMPTS=2
# LUMITHINK_REAL_PROVIDER_RETRY_BACKOFF_BASE_MS=500
# LUMITHINK_REAL_PROVIDER_BREAKER_FAILURE_THRESHOLD=3
# LUMITHINK_REAL_PROVIDER_BREAKER_COOLDOWN_MS=60000
# The credential is resolved AT REQUEST TIME only (never at startup, never
# logged; secrets-registry slot model_provider_api_key).
# LUMITHINK_MODEL_PROVIDER_KEY=
# Opt-in flag for the real-provider evidence runner (poc/dsh-child
# `test:e2e03:real`) — never set in CI.
# LUMITHINK_E2E03_REAL=

# ---------------------------------------------------------------------------
# R1-08 (issue #20) OPTIONAL deployment configuration — see
# deploy/env/production.example and deploy/runbook.md. Everything below is
# unset on the synthetic demo boot (CI + local dev); shapes are validated
# fail-closed and values are NEVER logged.
# ---------------------------------------------------------------------------

# Real guardian + admin access codes (MUST be set together; 12-128 chars, no
# whitespace, never the published demo codes). When set, login verifies these
# (SHA-256 digest, constant-time) and the demo codes are rejected.
# LUMITHINK_GUARDIAN_ACCESS_CODE=
# LUMITHINK_ADMIN_ACCESS_CODE=

# Encrypted runtime snapshot (AES-256-GCM). Path requires a key (exactly one
# of: 64-hex inline key OR controlled-mount key file).
# LUMITHINK_SNAPSHOT_PATH=
# LUMITHINK_SNAPSHOT_KEY=
# LUMITHINK_SNAPSHOT_KEY_FILE=
# LUMITHINK_SNAPSHOT_INTERVAL_MS=60000
# 1 = replay the child-deletion ledger once after a boot restore (set by
# deploy/restore.sh when placing an OLDER archive).
# LUMITHINK_SNAPSHOT_RESTORE_REPLAY=0
